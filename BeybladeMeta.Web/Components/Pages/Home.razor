@page "/"
@using System.Globalization
@using BeybladeMeta.Core.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MetaDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Beyblade X Meta Leaderboard</PageTitle>

<h1>Combo Meta Leaderboard</h1>
<p class="hint">Score = 3 × #1 + 2 × #2 + 1 × #3 appearances across all ingested tournament posts. Click a column to sort.</p>

@if (_all is null)
{
    <p>Loading…</p>
}
else if (_all.Count == 0)
{
    <p>No data yet — ingest some thread pages first via the <a href="ingest">Ingest</a> page.</p>
}
else
{
    <label>
        Week:
        <select @onchange="OnWeekChanged">
            <option value="">All weeks</option>
            @foreach (var week in _weeks)
            {
                <option value="@week" selected="@(week == _selectedWeek)">@week</option>
            }
            @if (_hasUndated)
            {
                <option value="?" selected="@(_selectedWeek == "?")">(unknown date)</option>
            }
        </select>
    </label>

    <table class="leaderboard">
        <thead>
            <tr>
                <th>#</th>
                <th>Combo</th>
                <th class="sortable" @onclick="@(() => SortBy(nameof(Row.First)))">#1 @Arrow(nameof(Row.First))</th>
                <th class="sortable" @onclick="@(() => SortBy(nameof(Row.Second)))">#2 @Arrow(nameof(Row.Second))</th>
                <th class="sortable" @onclick="@(() => SortBy(nameof(Row.Third)))">#3 @Arrow(nameof(Row.Third))</th>
                <th class="sortable" @onclick="@(() => SortBy(nameof(Row.Total)))">Total @Arrow(nameof(Row.Total))</th>
                <th class="sortable" @onclick="@(() => SortBy(nameof(Row.Score)))">Score @Arrow(nameof(Row.Score))</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (row, i) in Rows.Select((r, i) => (r, i)))
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td class="combo">@row.Display</td>
                    <td>@row.First</td>
                    <td>@row.Second</td>
                    <td>@row.Third</td>
                    <td>@row.Total</td>
                    <td><strong>@row.Score</strong></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private sealed record Appearance(string ComboKey, string Display, int Placement, string? Week);

    private sealed record Row(string Display, int First, int Second, int Third)
    {
        public int Total => First + Second + Third;
        public int Score => 3 * First + 2 * Second + Third;
    }

    private List<Appearance>? _all;
    private List<string> _weeks = [];
    private bool _hasUndated;
    private string _selectedWeek = "";
    private string _sortColumn = nameof(Row.Score);

    private IEnumerable<Row> Rows
    {
        get
        {
            var filtered = _selectedWeek switch
            {
                "" => _all!,
                "?" => _all!.Where(a => a.Week is null),
                _ => _all!.Where(a => a.Week == _selectedWeek),
            };
            var rows = filtered
                .GroupBy(a => a.ComboKey)
                .Select(g => new Row(
                    g.First().Display,
                    g.Count(a => a.Placement == 1),
                    g.Count(a => a.Placement == 2),
                    g.Count(a => a.Placement == 3)));
            return _sortColumn switch
            {
                nameof(Row.First) => rows.OrderByDescending(r => r.First),
                nameof(Row.Second) => rows.OrderByDescending(r => r.Second),
                nameof(Row.Third) => rows.OrderByDescending(r => r.Third),
                nameof(Row.Total) => rows.OrderByDescending(r => r.Total),
                _ => rows.OrderByDescending(r => r.Score),
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var raw = await db.Appearances
            .Select(a => new { a.ComboKey, a.Display, a.Placement, a.Post!.PostedAt })
            .ToListAsync();

        _all = raw.Select(a => new Appearance(a.ComboKey, a.Display, a.Placement, ToIsoWeek(a.PostedAt))).ToList();
        _weeks = _all.Where(a => a.Week is not null).Select(a => a.Week!)
            .Distinct().OrderByDescending(w => w).ToList();
        _hasUndated = _all.Any(a => a.Week is null);
    }

    private static string? ToIsoWeek(DateTime? date) =>
        date is null ? null : $"{ISOWeek.GetYear(date.Value)}-W{ISOWeek.GetWeekOfYear(date.Value):00}";

    private void OnWeekChanged(ChangeEventArgs e) => _selectedWeek = e.Value?.ToString() ?? "";

    private void SortBy(string column) => _sortColumn = column;

    private string Arrow(string column) => _sortColumn == column ? "▼" : "";
}
