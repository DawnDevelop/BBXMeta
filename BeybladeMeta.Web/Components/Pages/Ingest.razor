@page "/ingest"
@using BeybladeMeta.Core.Ingestion
@inject IngestionService Ingestion
@inject ThreadClient Thread
@rendermode InteractiveServer

<PageTitle>Ingest Thread Pages</PageTitle>

<h1>Ingest</h1>

<section>
    <h2>Fetch from worldbeyblade.org</h2>
    <p class="hint">Fetches thread pages directly. If the forum blocks the request (403), use the file upload below instead.</p>
    <label>From page <input type="number" min="1" @bind="_fromPage" /></label>
    <label>to <input type="number" min="1" @bind="_toPage" /></label>
    <button disabled="@_busy" @onclick="FetchPages">Fetch &amp; ingest</button>
</section>

<section>
    <h2>Upload saved HTML pages</h2>
    <p class="hint">Save thread pages from your browser (Ctrl+S, "Webpage, HTML Only") and upload them here. Page number is read from the file name if it contains one (e.g. "...page=152.html").</p>
    <InputFile OnChange="UploadFiles" multiple accept=".html,.htm" />
</section>

@if (_busy)
{
    <p>Working… @_status</p>
}
else if (_log.Count > 0)
{
    <ul class="ingest-log">
        @foreach (var line in _log)
        {
            <li>@line</li>
        }
    </ul>
}

@code {
    private int _fromPage = 1;
    private int _toPage = 1;
    private bool _busy;
    private string _status = "";
    private readonly List<string> _log = [];

    private async Task FetchPages()
    {
        _busy = true;
        _log.Clear();
        try
        {
            for (var page = _fromPage; page <= _toPage; page++)
            {
                _status = $"fetching page {page}…";
                StateHasChanged();
                try
                {
                    var html = await Thread.GetPageHtmlAsync(page);
                    var report = await Ingestion.IngestHtmlAsync(html, page);
                    _log.Add($"Page {page}: {report.PostsIngested}/{report.PostsSeen} posts ingested, {report.Combos} combos, {report.UnmatchedLines} unmatched lines.");
                }
                catch (HttpRequestException ex)
                {
                    _log.Add($"Page {page}: fetch failed ({ex.Message}). The forum may be blocking requests — use the HTML upload below.");
                    break;
                }
                await Task.Delay(TimeSpan.FromSeconds(2)); // be polite to the forum
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        _busy = true;
        _log.Clear();
        try
        {
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 200))
            {
                _status = $"ingesting {file.Name}…";
                StateHasChanged();
                using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024));
                var html = await reader.ReadToEndAsync();
                var page = ExtractPageNumber(file.Name);
                var report = await Ingestion.IngestHtmlAsync(html, page);
                _log.Add($"{file.Name}: {report.PostsIngested}/{report.PostsSeen} posts ingested, {report.Combos} combos, {report.UnmatchedLines} unmatched lines.");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static int ExtractPageNumber(string fileName)
    {
        var match = System.Text.RegularExpressions.Regex.Match(fileName, @"(\d+)");
        return match.Success ? int.Parse(match.Value) : 0;
    }
}
