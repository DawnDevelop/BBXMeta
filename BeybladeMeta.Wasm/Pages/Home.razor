@page "/"
@inject HttpClient Http

<PageTitle>Beyblade X Meta Leaderboard</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Beyblade X Meta Leaderboard</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Score = 3 × #1 + 2 × #2 + 1 × #3 placements. Movement (▲▼) compares the selected period to
    the period of the same length before it.
    @if (_anchor is { } a)
    {
        <text> · Data through <strong>@a.ToString("MMM d, yyyy")</strong>.</text>
    }
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Info">@_error</MudAlert>
}
else if (_all is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_all.Count == 0)
{
    <MudAlert Severity="Severity.Info">No data indexed yet.</MudAlert>
}
else
{
    <div style="max-width: 940px; margin-inline: auto;">
        <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged" Color="Color.Primary"
                        Size="Size.Medium" CheckMark="false" SelectionMode="SelectionMode.SingleSelection" Class="mb-4">
            <MudToggleItem Value="@("blades")" Text="Blades" />
            <MudToggleItem Value="@("combos")" Text="Combos" />
            <MudToggleItem Value="@("ratchets")" Text="Ratchets" />
            <MudToggleItem Value="@("bits")" Text="Bits" />
        </MudToggleGroup>

        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;" class="mb-3">
            <MudSelect T="string" Value="_selectedWindow" ValueChanged="OnWindowChanged" Label="Time range"
                       Variant="Variant.Outlined" Dense="true" Style="width: 12rem;">
                @foreach (var w in Windows)
                {
                    <MudSelectItem T="string" Value="@w.Key">@w.Label</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" Dense="true"
                          Clearable="true" Immediate="true" DebounceInterval="150"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="width: 15rem;" />
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Rows.Count() @_view</MudText>
        </div>

        <MudTable Items="Rows" Hover="true" Dense="true" Elevation="2" T="RankRow">
        <HeaderContent>
            @if (HasDrilldown)
            {
                <MudTh Style="width: 2.5rem;" />
            }
            <MudTh Style="width: 3rem; text-align: right;">#</MudTh>
            <MudTh>@ColumnName</MudTh>
            <MudTh Style="width: 3.5rem; text-align: right;">#1</MudTh>
            <MudTh Style="width: 3.5rem; text-align: right;">#2</MudTh>
            <MudTh Style="width: 3.5rem; text-align: right;">#3</MudTh>
            <MudTh Style="width: 4rem; text-align: right;">Total</MudTh>
            <MudTh Style="width: 4.5rem; text-align: right;">Score</MudTh>
            <MudTh Style="width: 4rem; text-align: center;">+/−</MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (HasDrilldown)
            {
                <MudTd Style="padding-right: 0;">
                    <MudIconButton Size="Size.Small" OnClick="@(() => Toggle(context.Name))"
                                   Icon="@(IsExpanded(context.Name) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" />
                </MudTd>
            }
            <MudTd DataLabel="#" Class="mud-text-secondary" Style="text-align: right;">@context.Rank</MudTd>
            <MudTd DataLabel="@ColumnName"><strong>@context.Name</strong></MudTd>
            <MudTd DataLabel="#1" Style="text-align: right;">@context.First</MudTd>
            <MudTd DataLabel="#2" Style="text-align: right;">@context.Second</MudTd>
            <MudTd DataLabel="#3" Style="text-align: right;">@context.Third</MudTd>
            <MudTd DataLabel="Total" Style="text-align: right;">@context.Total</MudTd>
            <MudTd DataLabel="Score" Style="text-align: right;"><strong>@context.Score</strong></MudTd>
            <MudTd DataLabel="+/−" Style="text-align: center;">@Movement(context)</MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (HasDrilldown && IsExpanded(context.Name))
            {
                <MudTr>
                    <td colspan="9" class="pa-4" style="background: var(--mud-palette-background-grey);">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Top combos using @context.Name</MudText>
                        <MudSimpleTable Dense="true" Style="background: transparent;">
                            <thead>
                                <tr><th>Combo</th><th>#1</th><th>#2</th><th>#3</th><th>Times run</th><th>Score</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var (combo, i) in CombosForKey(context.Name).Select((c, i) => (c, i)))
                                {
                                    <tr>
                                        <td>
                                            <code>@combo.Name</code>
                                            @if (i == 0 && combo.Score > 0)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ml-2">best</MudChip>
                                            }
                                        </td>
                                        <td>@combo.First</td><td>@combo.Second</td><td>@combo.Third</td>
                                        <td>@combo.Total</td><td><strong>@combo.Score</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
        </MudTable>
    </div>
}

@code {
    public sealed record Appearance(string Blade, string Display, string? Ratchet, string Bit, int Placement, string? Date)
    {
        public DateOnly? On => DateOnly.TryParse(Date, out var d) ? d : null;
    }

    public sealed record RankRow(string Name, int First, int Second, int Third)
    {
        public int Total => First + Second + Third;
        public int Score => 3 * First + 2 * Second + Third;
        public int Rank { get; init; }
        public int? Delta { get; init; } // prior rank − current rank; null = no prior data
        public bool IsNew { get; init; }
    }

    private sealed record Window(string Key, string Label, Func<DateOnly, DateOnly?> Cutoff);

    private static readonly Window[] Windows =
    [
        new("all", "All time", _ => null),
        new("1w", "Last 1 week", t => t.AddDays(-7)),
        new("2w", "Last 2 weeks", t => t.AddDays(-14)),
        new("4w", "Last 4 weeks", t => t.AddDays(-28)),
        new("3m", "Last 3 months", t => t.AddMonths(-3)),
        new("6m", "Last 6 months", t => t.AddMonths(-6)),
    ];

    private List<Appearance>? _all;
    private string _view = "blades";
    private string _selectedWindow = "4w";
    private string? _search;
    private readonly HashSet<string> _expanded = [];

    private List<Appearance> _current = [];
    private List<Appearance>? _prior;
    private DateOnly? _anchor; // latest event date in the data — the reference for all windows

    private string ColumnName => _view switch { "combos" => "Combo", "ratchets" => "Ratchet", "bits" => "Bit", _ => "Blade" };

    private Func<Appearance, string?> KeySelector => _view switch
    {
        "combos" => a => a.Display,
        "ratchets" => a => a.Ratchet,
        "bits" => a => a.Bit,
        _ => a => a.Blade,
    };

    private void RecomputeWindow()
    {
        // Anchor windows to the newest event in the data (the last import), not the
        // calendar today, so "last N weeks" stays populated as the data ages.
        var today = _anchor ?? DateOnly.FromDateTime(DateTime.Today);
        var cutoff = Windows.First(w => w.Key == _selectedWindow).Cutoff(today);
        if (cutoff is null)
        {
            _current = _all!;
            _prior = null;
        }
        else
        {
            var length = today.DayNumber - cutoff.Value.DayNumber;
            var priorStart = cutoff.Value.AddDays(-length);
            _current = _all!.Where(a => a.On is { } d && d >= cutoff).ToList();
            _prior = _all!.Where(a => a.On is { } d && d >= priorStart && d < cutoff).ToList();
        }
        _expanded.Clear();
    }

    private IEnumerable<RankRow> Rows
    {
        get
        {
            var rows = Rank(_current, _prior, KeySelector);
            return string.IsNullOrWhiteSpace(_search)
                ? rows
                : rows.Where(r => r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static List<RankRow> Rank(List<Appearance> current, List<Appearance>? prior, Func<Appearance, string?> key)
    {
        var priorRanks = prior is null ? null : RankIndex(prior, key);
        return Group(current, key)
            .OrderByDescending(r => r.Score)
            .Select((r, i) =>
            {
                var rank = i + 1;
                int? delta = priorRanks is not null && priorRanks.TryGetValue(r.Name, out var pr) ? pr - rank : null;
                var isNew = priorRanks is not null && !priorRanks.ContainsKey(r.Name);
                return r with { Rank = rank, Delta = delta, IsNew = isNew };
            })
            .ToList();
    }

    private static Dictionary<string, int> RankIndex(List<Appearance> data, Func<Appearance, string?> key) =>
        Group(data, key)
            .OrderByDescending(r => r.Score)
            .Select((r, i) => (r.Name, Rank: i + 1))
            .ToDictionary(x => x.Name, x => x.Rank);

    private static IEnumerable<RankRow> Group(IEnumerable<Appearance> data, Func<Appearance, string?> key) =>
        data.Where(a => !string.IsNullOrEmpty(key(a)))
            .GroupBy(key)
            .Select(g => new RankRow(
                g.Key!,
                g.Count(a => a.Placement == 1),
                g.Count(a => a.Placement == 2),
                g.Count(a => a.Placement == 3)));

    // Blades, ratchets and bits drill down into their combos; combos are already the leaf.
    private bool HasDrilldown => _view != "combos";

    private IEnumerable<RankRow> CombosForKey(string name)
    {
        var key = KeySelector;
        return Rank(_current.Where(a => key(a) == name).ToList(), null, a => a.Display)
            .OrderByDescending(c => c.Score).ThenByDescending(c => c.Total);
    }

    private bool IsExpanded(string name) => _expanded.Contains(name);
    private void Toggle(string name) { if (!_expanded.Remove(name)) _expanded.Add(name); }

    private void OnViewChanged(string view) { _view = view; _expanded.Clear(); }
    private void OnWindowChanged(string window) { _selectedWindow = window; RecomputeWindow(); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await Http.GetFromJsonAsync<List<Appearance>>("data/appearances.json") ?? [];
            _anchor = _all.Where(a => a.On is not null).Select(a => a.On!.Value).DefaultIfEmpty().Max();
            if (_anchor == default)
            {
                _anchor = null;
                _selectedWindow = "all";
            }
            RecomputeWindow();
        }
        catch (HttpRequestException)
        {
            _error = "No data published yet (data/appearances.json missing).";
        }
    }

    private string? _error;

    private RenderFragment Movement(RankRow r) =>@<span style="display:inline-flex; align-items:center; justify-content:center; gap:2px;">
        @if (r.IsNew)
        {
            <span style="color:var(--mud-palette-info); font-size:0.75rem;">new</span>
        }
        else if (r.Delta is { } d && d != 0)
        {
            <MudIcon Size="Size.Small" Color="@(d > 0 ? Color.Success : Color.Error)"
                     Icon="@(d > 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" />
            <span>@Math.Abs(d)</span>
        }
        else
        {
            <span class="mud-text-secondary">—</span>
        }
    </span>;
}
